sonar.projectKey=<your-sonarcloud-project-key>
sonar.organization=<your-sonarcloud-org-key>
sonar.projectName=Online Code Test

sonar.sources=apps,packages
sonar.exclusions=**/node_modules/**,**/dist/**,**/coverage/**,**/*.test.ts,**/*.test.tsx,**/*.spec.ts,**/*.spec.tsx,**/test-setup.ts

sonar.typescript.lcov.reportPaths=apps/api/coverage/lcov.info,apps/judge-worker/coverage/lcov.info,apps/web/coverage/lcov.info

sonar.host.url=https://sonarcloud.io

sonar.sourceEncoding=UTF-8

# Token is NOT stored here. Pass it at run time via the SONAR_TOKEN env var.
