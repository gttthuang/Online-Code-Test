{
  "name": "online-code-test",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @oct/api",
    "dev:web": "npm run dev --workspace @oct/web",
    "dev:worker": "npm run dev --workspace @oct/judge-worker",
    "build:web": "npm run build --workspace @oct/web",
    "test:api": "npm run test --workspace @oct/api",
    "test:system": "npm run test:system --workspace @oct/api",
    "test:worker": "npm run test --workspace @oct/judge-worker",
    "test:web": "npm run test --workspace @oct/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:infra": "bash infra/verify.sh",
    "ci:verify": "npm run typecheck && npm run test:coverage && npm run test:system && npm run build:web && npm run verify:infra",
    "test:coverage": "npm run test:coverage --workspace @oct/api && npm run test:coverage --workspace @oct/judge-worker && npm run test:coverage --workspace @oct/web",
    "sonar-scanner": "npx sonarqube-scanner"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "monaco-editor": "0.53.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}