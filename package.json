{
  "name": "online-code-test",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @oct/api",
    "dev:web": "npm run dev --workspace @oct/web",
    "dev:worker": "npm run dev --workspace @oct/judge-worker",
    "build:web": "npm run build --workspace @oct/web",
    "test:api": "npm run test --workspace @oct/api",
    "test:web": "npm run test --workspace @oct/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ci:verify": "npm run typecheck && npm run test:api && npm run test:web && npm run build:web",
    "test:coverage": "npm run test:coverage --workspace @oct/api && npm run test:coverage --workspace @oct/web",
    "presonar-scanner": "npm run test:coverage",
    "sonar-scanner": "npx sonarqube-scanner"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "react-quill": "^2.0.0"
  }
}
