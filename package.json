{
  "name": "online-code-test",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @oct/api",
    "dev:web": "npm run dev --workspace @oct/web",
    "dev:worker": "npm run dev --workspace @oct/judge-worker",
    "build:web": "npm run build --workspace @oct/web",
    "test:api": "npm run test --workspace @oct/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ci:verify": "npm run typecheck && npm run test:api && npm run build:web",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.4"
  }
}
